{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rulebook",
  "description": "Event rules from the Live Financial Ecosystem Rulebook. Single source of truth: the Go backend loads rulebook.json directly; the web app gets types generated from this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "roles", "event", "market", "teams", "accounts", "qualification", "fund", "fees", "news", "rateLimits", "leaderboard", "disputes", "prizes", "technical", "provenance"],
  "properties": {
    "version": { "type": "string" },
    "source": { "type": "string" },
    "roles": { "type": "array", "items": { "enum": ["investor", "fund_manager"] } },

    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalMinutes", "participants", "timeline"],
      "properties": {
        "totalMinutes": { "type": "integer", "minimum": 1 },
        "participants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
        },
        "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/EventBlock" } }
      }
    },

    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbolCount"],
      "properties": { "symbolCount": { "type": "integer", "minimum": 1 } }
    },

    "teams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["investorTeamSize", "fundTeamSize", "fundManagerSeats"],
      "properties": {
        "investorTeamSize": { "type": "integer", "minimum": 1 },
        "fundTeamSize": { "type": "integer", "minimum": 1 },
        "fundManagerSeats": { "type": "integer", "minimum": 1 }
      }
    },

    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startingCapital", "currency"],
      "properties": { "startingCapital": { "type": "number", "exclusiveMinimum": 0 }, "currency": { "type": "string" } }
    },

    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualifyingTeams", "fundCount", "pairing", "tieBreak"],
      "properties": {
        "qualifyingTeams": { "type": "integer", "minimum": 2 },
        "fundCount": { "type": "integer", "minimum": 1 },
        "pairing": { "enum": ["mirror"] },
        "tieBreak": { "type": "array", "items": { "enum": ["peak_portfolio_value", "fewer_transactions", "coin_toss"] } }
      }
    },

    "fund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launchNav", "minInvestmentAbsolute", "minInvestmentWalletPercent", "maxSingleFundWalletPercent", "mandatoryAllocationPercent", "seedCapital"],
      "properties": {
        "launchNav": { "type": "number", "exclusiveMinimum": 0 },
        "minInvestmentAbsolute": { "type": "number", "minimum": 0 },
        "minInvestmentWalletPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxSingleFundWalletPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "mandatoryAllocationPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "seedCapital": { "type": "number", "minimum": 0 }
      }
    },

    "fees": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managementFeePercent", "performanceFeePercent", "managementFeeBasis"],
      "properties": {
        "managementFeePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "performanceFeePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "managementFeeBasis": { "enum": ["per_period"] }
      }
    },

    "news": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fundManagerLeadSeconds"],
      "properties": { "fundManagerLeadSeconds": { "type": "integer", "minimum": 0 } }
    },

    "rateLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tradesPerWindow", "windowSeconds", "scope"],
      "properties": {
        "tradesPerWindow": { "type": "integer", "minimum": 1 },
        "windowSeconds": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["account"] }
      }
    },

    "leaderboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refreshSeconds", "navSampleSeconds", "investorFields", "fundFields", "exposeHoldings"],
      "properties": {
        "refreshSeconds": { "type": "integer", "minimum": 1 },
        "navSampleSeconds": { "type": "integer", "minimum": 1 },
        "investorFields": { "type": "array", "items": { "type": "string" } },
        "fundFields": { "type": "array", "items": { "type": "string" } },
        "exposeHoldings": { "type": "boolean" }
      }
    },

    "disputes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expeditedPerPhase", "overflowQueue", "raiseWithinMinutes", "expeditedTurnaroundMinutes"],
      "properties": {
        "expeditedPerPhase": { "type": "integer", "minimum": 0 },
        "overflowQueue": { "enum": ["standard"] },
        "raiseWithinMinutes": { "type": "integer", "minimum": 1 },
        "expeditedTurnaroundMinutes": { "type": "integer", "minimum": 1 }
      }
    },

    "prizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prize1", "prize4", "prize3"],
      "properties": {
        "prize1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["performance", "riskManagement", "investorProfitability", "retention"],
          "properties": {
            "performance": { "type": "number", "minimum": 0 },
            "riskManagement": { "type": "number", "minimum": 0 },
            "investorProfitability": { "type": "number", "minimum": 0 },
            "retention": { "type": "number", "minimum": 0 }
          }
        },
        "prize4": {
          "type": "object",
          "additionalProperties": false,
          "required": ["riskAdjustedReturn", "drawdownControl", "diversification", "diversificationCapHoldings"],
          "properties": {
            "riskAdjustedReturn": { "type": "number", "minimum": 0 },
            "drawdownControl": { "type": "number", "minimum": 0 },
            "diversification": { "type": "number", "minimum": 0 },
            "diversificationCapHoldings": { "type": "number", "minimum": 1 }
          }
        },
        "prize3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategyLogCheckpoints", "rubric"],
          "properties": {
            "strategyLogCheckpoints": { "type": "integer", "minimum": 1 },
            "rubric": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["criterion", "weight", "maxScore"],
                "properties": {
                  "criterion": { "type": "string" },
                  "weight": { "type": ["number", "null"] },
                  "maxScore": { "type": ["number", "null"] }
                }
              }
            }
          }
        }
      }
    },

    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumDeviceRequirements"],
      "properties": { "minimumDeviceRequirements": { "type": ["string", "null"] } }
    },

    "provenance": {
      "description": "Which values are not yet final. Keyed by dotted path into this document; any value without an entry is fixed by the rulebook.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/Provenance" }
    }
  },

  "definitions": {
    "EventBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "publicLabel", "durationMin", "stage", "marketOpen", "allocationWindow"],
      "properties": {
        "id": { "type": "string" },
        "label": { "description": "Organiser-internal label; may name the confidential regime-event block.", "type": "string" },
        "publicLabel": { "description": "Participant-facing label; never reveals the regime-event block.", "type": "string" },
        "durationMin": { "type": "integer", "minimum": 1 },
        "stage": { "enum": ["phase1", "transition", "phase2", "closing"] },
        "marketOpen": { "type": "boolean" },
        "allocationWindow": { "enum": [0, 1, 2, 3, null] },
        "freezeSnapshot": { "description": "Capture freeze prices at the start of this block.", "enum": ["phase1", "final"] },
        "regimeEvent": { "description": "Organiser-confidential: a scheduled Bull/Bear Run happens in this block.", "type": "boolean" }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "section"],
      "properties": {
        "status": { "enum": ["recommended", "tbf", "assumption"] },
        "section": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
