# Copy to /etc/stockastic/env, fill in, and make it readable only by the service user (chmod 600).
# Never commit the real file.

# 32 or more random characters, for example: openssl rand -hex 32
JWT_SECRET=

# The organiser login. The password needs 12 or more characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Behind Caddy, keep this on the local machine.
ADDR=127.0.0.1:8080
DATA_DIR=/var/lib/stockastic/data

# PostgreSQL as the durable record (recommended). When set, the log file in DATA_DIR is not used.
# Use sslmode=require when the database is on another machine (for example Amazon RDS).
# DATABASE_URL=postgres://stockastic:CHANGE_ME@127.0.0.1:5432/stockastic?sslmode=disable

# Let teams register themselves. Turn off once everyone has an account.
ALLOW_SIGNUP=true

# The public address people open in their browser (needed for the live connection).
ALLOWED_ORIGINS=https://event.example.com

# The real company list (see apps/api/internal/universe). Without it a small placeholder list is used.
# UNIVERSE_PATH=/etc/stockastic/universe.json
# The market: volatility, price limits, scheduled events and bull or bear runs. Without it a plain random walk is used.
# SCENARIO_PATH=/etc/stockastic/scenario.json
# New trades are refused when free disk space falls below this many megabytes (the Systems page shows it).
DISK_MIN_FREE_MB=200
# An edited copy of the rulebook values, once the organisers finalise them.
# RULEBOOK_PATH=/etc/stockastic/rulebook.json

# ---- protection against abuse ----
# A code people must enter to register (announce it in the room). Leave empty to need none. Organisers can change it live.
SIGNUP_CODE=
# The most accounts that can exist. A sign-up flood cannot go past this.
MAX_ACCOUNTS=1500
# Live connections: in all, and per account (a newer one replaces the oldest).
MAX_SOCKETS=4000
MAX_SOCKETS_PER_ACCOUNT=4
# Addresses whose X-Forwarded-For header is believed. Keep the default when Caddy runs on the same machine.
TRUSTED_PROXIES=127.0.0.1,::1

# ---- Google sign-in (optional; see docs/owner-checklist.md). Leave all three empty to keep it off. ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://event.example.com/api/auth/google/callback
# Only emails at these domains may sign in (comma separated). Empty means any Google account.
# GOOGLE_ALLOWED_DOMAINS=

LOG_LEVEL=info
