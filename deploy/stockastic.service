[Unit]
Description=Stockastic event platform
After=network-online.target postgresql.service
Wants=network-online.target
# Start after PostgreSQL if it runs on this same machine. Harmless if it does not: a unit that does not exist is
# simply skipped, it never blocks or fails this one.
# A crash loop must not run forever and fill the disk with logs: stop trying after 20 starts in 5 minutes and
# wait for an organiser. A single crash or reboot restarts by itself within seconds. An ordinary bounce of the
# database (a package update restarting it, the machine still booting) is handled inside the server itself, which
# retries opening the database for up to 3 minutes before giving up — so it does not use up these 20 tries at all;
# they are reserved for a genuinely broken start (bad settings, a crash on every boot).
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
User=stockastic
Group=stockastic
WorkingDirectory=/var/lib/stockastic
EnvironmentFile=/etc/stockastic/env
ExecStart=/opt/stockastic/api
# If the server ever stops, bring it back within seconds. It rebuilds everything from its log.
Restart=always
RestartSec=3
# Give a clean shutdown time to finish saving trades before systemd gives up.
TimeoutStopSec=30
# One open connection per browser, plus the log and a margin.
LimitNOFILE=65535

# Safety: the server needs its data folder and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stockastic
# The server needs no devices, no kernel settings, no other users' files and no way to gain power. If it were ever
# taken over, this is how little it could do.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# Bounds so a fault or an attack cannot take the whole machine down with it.
MemoryMax=3G
TasksMax=8192

[Install]
WantedBy=multi-user.target
